{
  "globs": [
    "*.md",
    "docs/**/*.md",
    "tests/**/*.md",
    "results/**/*.md"
  ],
  "ignores": [
    "tests/*/lab/clab-*/**",
    "tests/*/runs/**",
    "results/**/inputs/**",
    // Copied unchanged into the campaign README under a level-2 heading; linted there.
    "results/*/notes.md"
  ],
  "config": {
    "MD013": false,
    "MD060": {
      "style": "compact"
    }
  }
}
