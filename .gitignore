.DS_Store

# Python and uv
.venv/
.uv-cache/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local editor state
.vscode/

# Containerlab lab directories and RouterOS syslog feeds
labs/*/clab-*/
tests/*/lab/clab-*/
labs/*/*logs/*.jsonl

# Local runs and checkpoints
test-results/
networka-results/
.networka-venv/
schemas/

# Results: new raw evidence is stored with campaign artifacts.
/results/2026-11-24-small-lab/test-suite-evidence/
/results/**/*.tar.gz
/results/**/*.pcap
/results/**/*.pcapng

# Raw per-run evidence stays local; reports, verdicts, configs and the index are committed.
/results/**/state-*.jsonl
/results/**/syslog.jsonl
/results/**/events.jsonl
/results/**/captures/
/results/**/probes/
/results/**/links/
# Run inputs: keep the startup configs, not the source snapshot.
/results/**/inputs/*
!/results/**/inputs/*.rsc
!/results/**/inputs/*.clab.yml
!/results/**/inputs/client-network.sh
/results/**/effective-config.json

# Internal work records stay local.
/docs/plans/forwarding-checks-and-speed-plan.md
/docs/plans/forwarding-checks-and-speed-log.md
/docs/plans/replay-speed-analysis.md
