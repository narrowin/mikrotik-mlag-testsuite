        <mxCell id="dc1-test-2-0" value="One core down and back" style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=17;fontColor=#784082;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="20" y="539" width="416" height="21" as="geometry" />
        </mxCell>
        <mxCell id="dc1-test-2-1" value="Check whether the survivor forwards during loss." style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=15;fontColor=#231D2C;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="20" y="566" width="416" height="18" as="geometry" />
        </mxCell>
        <mxCell id="dc1-test-2-2" value="Keep probing after rejoin to catch a second gap." style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=15;fontColor=#231D2C;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="20" y="584" width="416" height="18" as="geometry" />
        </mxCell>
        <mxCell id="dc1-test-3-0" value="Both cores down and back · planned" style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=17;fontColor=#784082;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="464" y="539" width="416" height="21" as="geometry" />
        </mxCell>
        <mxCell id="dc1-test-3-1" value="Restore Core 1 first, Core 2 first, and both together" style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=15;fontColor=#231D2C;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="464" y="566" width="416" height="18" as="geometry" />
        </mxCell>
        <mxCell id="dc1-test-3-2" value="in separate runs. Time first stable VLAN service" style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=15;fontColor=#231D2C;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="464" y="584" width="416" height="18" as="geometry" />
