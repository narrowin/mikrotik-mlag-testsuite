        <mxCell id="dc1-test-0-0" value="First, run with STP off" style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=17;fontColor=#784082;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="20" y="447" width="416" height="21" as="geometry" />
        </mxCell>
        <mxCell id="dc1-test-0-1" value="Disable STP on all three bridges. Verify VLAN" style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=15;fontColor=#231D2C;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="20" y="474" width="416" height="18" as="geometry" />
        </mxCell>
        <mxCell id="dc1-test-0-2" value="and bypass delivery. Then run the reboot tests." style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=15;fontColor=#231D2C;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="20" y="492" width="416" height="18" as="geometry" />
        </mxCell>
        <mxCell id="dc1-test-1-0" value="Then compare RSTP root placements" style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=17;fontColor=#784082;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="464" y="447" width="416" height="21" as="geometry" />
        </mxCell>
        <mxCell id="dc1-test-1-1" value="Elect the core pair in one run and the access" style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=15;fontColor=#231D2C;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="464" y="474" width="416" height="18" as="geometry" />
        </mxCell>
        <mxCell id="dc1-test-1-2" value="switch in another. Verify VLAN delivery" style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=15;fontColor=#231D2C;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
          <mxGeometry x="464" y="492" width="416" height="18" as="geometry" />
