        <mxCell id="note-31" value="What we test and why" style="text;html=0;strokeColor=none;fillColor=none;spacing=0;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=17;fontColor=#514B60;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1" data-kind="annotation">
